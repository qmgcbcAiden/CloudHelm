FROM alpine:3.22.2@sha256:4b7ce07002c69e8f3d704a9c5d6fd3053be500b7f1c69fc0d80990c2ad8dd412 AS sudo-pam
# Alpine's distribution sudo is intentionally built --without-pam. Build the
# same verified upstream release with real Linux PAM for the MFA fixture.
RUN apk add --no-cache build-base linux-pam-dev zlib-dev curl ca-certificates \
    && curl -fsSL https://www.sudo.ws/dist/sudo-1.9.17p2.tar.gz -o /tmp/sudo.tar.gz \
    && echo 'c8abd6ca56e54a081c9ef1e9f6579d1db5b93ff857e60d1f58d1f425d7dc23c31c58d40b7819780688f66dfdf87a1f3bbe0a78387b007e2beb1b0e546203ea93  /tmp/sudo.tar.gz' | sha512sum -c - \
    && tar -xzf /tmp/sudo.tar.gz -C /tmp \
    && cd /tmp/sudo-1.9.17p2 \
    && ./configure --prefix=/usr --sysconfdir=/etc --libexecdir=/usr/lib --with-pam --without-skey --disable-nls \
    && make -j2 && make install

FROM alpine:3.22.2@sha256:4b7ce07002c69e8f3d704a9c5d6fd3053be500b7f1c69fc0d80990c2ad8dd412
RUN apk add --no-cache openssh-server-pam openssh-client sudo bash coreutils util-linux-login linux-pam google-authenticator \
    && adduser -D -s /bin/bash cloudhelm
COPY --from=sudo-pam /usr/bin/sudo /usr/bin/sudo
COPY --from=sudo-pam /usr/lib/sudo /usr/lib/sudo
RUN printf '%s\n' 'auth required pam_unix.so' 'account required pam_unix.so' 'session required pam_unix.so' > /etc/pam.d/sudo
COPY helper process.test files.test entrypoint.sh /fixture/
ENTRYPOINT ["/bin/sh", "/fixture/entrypoint.sh"]

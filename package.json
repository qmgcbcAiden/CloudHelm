{
  "name": "cloudhelm",
  "private": true,
  "version": "0.2.4",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @cloudhelm/desktop dev",
    "build": "pnpm --filter @cloudhelm/desktop build",
    "build:native": "node scripts/build-native-helper.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint apps packages scripts Tests",
    "lint:deps": "depcruise --config .dependency-cruiser.cjs apps packages scripts Tests",
    "lint:lines": "node scripts/check-lines.mjs",
    "lint:tests": "node scripts/check-test-layout.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm lint && pnpm lint:deps && pnpm lint:lines && pnpm lint:tests && pnpm version:check && pnpm changelog:check",
    "prepare": "node scripts/setup-hooks.mjs",
    "version:set": "node scripts/set-version.mjs",
    "version:check": "node scripts/set-version.mjs --check",
    "changelog:check": "node scripts/changelog.mjs --check",
    "test:ui": "node Tests/smoke/ui-smoke.mjs",
    "test:file-preview": "node Tests/smoke/file-preview-smoke.mjs",
    "test:desktop": "node Tests/smoke/desktop-smoke.mjs",
    "test:desktop:packaged": "node Tests/smoke/desktop-smoke.mjs --packaged",
    "test:markdown": "node Tests/smoke/markdown-smoke.mjs",
    "test:ai-panel": "node Tests/smoke/ai-panel-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.7.2",
    "dependency-cruiser": "17.3.6",
    "electron-vite": "5.0.0",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vite": "7.3.6",
    "vitest": "3.2.4"
  }
}

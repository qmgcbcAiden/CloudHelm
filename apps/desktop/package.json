{
  "name": "@cloudhelm/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "@cloudhelm/adapters": "workspace:*",
    "@cloudhelm/application": "workspace:*",
    "@cloudhelm/contracts": "workspace:*",
    "@cloudhelm/core": "workspace:*",
    "@earendil-works/pi-agent-core": "0.99.1",
    "@earendil-works/pi-ai": "0.99.1",
    "@xterm/xterm": "6.0.0",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "ssh2": "1.17.0",
    "typebox": "1.3.27",
    "web-tree-sitter": "0.27.0",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/ssh2": "1.15.5",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0"
  },
  "build": {
    "appId": "dev.cloudhelm.app",
    "productName": "CloudHelm",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/*.wasm"
    ],
    "extraResources": [
      {
        "from": "resources/tree-sitter-bash.wasm",
        "to": "tree-sitter-bash.wasm"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
